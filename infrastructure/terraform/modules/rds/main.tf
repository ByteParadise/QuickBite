# ! RDS Proxy "standard" IAM auth
# account-service authenticates to the PROXY with a short-lived IAM token.
# The proxy itself authenticates to the real Postgres instance using a
# RDS-managed master secret, auto generated/stored/rotated by AWS Secrets
# Manager.

# ? Full path
# pod -> Pod Identity credentials -> IAM token -> proxy (checks token, TLS)
# -> database (master secret)

# Assigns RDS private subnet
resource "aws_db_subnet_group" "account_service" {
  name       = "quickbite-account-service"
  subnet_ids = var.private_subnet_ids
}

# Creates firewall for RDS; only allows inbound traffic (port 5432) from the
# Proxy's security group specifically.
resource "aws_security_group" "rds_account_service" {
  name   = "quickbite-rds-account-service"
  vpc_id = var.vpc_id

  ingress {
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.rds_proxy_account_service.id]
  }
}

# Create firewall for the proxy; only allows inbound traffict from EKS cluster
# security group (so only pods on it can reach it), and allows outbound
# traffic to reach the db.
resource "aws_security_group" "rds_proxy_account_service" {
  name   = "quickbite-rds-proxy-account-service"
  vpc_id = var.vpc_id

  ingress {
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [var.eks_cluster_security_group_id]
  }
}

# Allow proxy to connect to RDS's SG.
# This is separately done since inline cross-references causes a cycle.
resource "aws_vpc_security_group_egress_rule" "proxy_to_rds" {
  security_group_id            = aws_security_group.rds_proxy_account_service.id
  referenced_security_group_id = aws_security_group.rds_account_service.id
  ip_protocol                  = "tcp"
  from_port                    = 5432
  to_port                      = 5432
}

# The RDS
resource "aws_db_instance" "account_service" {
  identifier     = "quickbite-account-service"
  engine         = "postgres"
  engine_version = "17"
  instance_class = var.instance_class
  multi_az       = var.multi_az

  allocated_storage = var.allocated_storage # ?
  storage_type      = "gp3" # ?

  db_name  = "account_service"
  username = "account_service_app"

  # AWS generates, stores, and rotates this in Secrets Manager directly.
  # Proxy will use this secret key in order to connect to the database
  manage_master_user_password = true

  db_subnet_group_name    = aws_db_subnet_group.account_service.name
  vpc_security_group_ids  = [aws_security_group.rds_account_service.id]
  publicly_accessible     = false

  # No snapshot needed on teardown.
  skip_final_snapshot = var.skip_final_snapshot
}

# Trust policy for proxy to assume
data "aws_iam_policy_document" "rds_proxy_assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["rds.amazonaws.com"]
    }
  }
}

# Proxy IAM role
resource "aws_iam_role" "rds_proxy" {
  name               = "quickbite-rds-proxy-account-service"
  assume_role_policy = data.aws_iam_policy_document.rds_proxy_assume.json
}

# Proxy permissions — alows it to read master secret key generated by aws_db_instance above
data "aws_iam_policy_document" "rds_proxy_secret_access" {
  statement {
    actions   = ["secretsmanager:GetSecretValue"]
    resources = [aws_db_instance.account_service.master_user_secret[0].secret_arn]
  }
}

# Associate the role with the permissions
resource "aws_iam_role_policy" "rds_proxy_secret_access" {
  role   = aws_iam_role.rds_proxy.id
  policy = data.aws_iam_policy_document.rds_proxy_secret_access.json
}

# Create the proxy itself
resource "aws_db_proxy" "account_service" {
  name                    = "quickbite-account-service"
  engine_family           = "POSTGRESQL"
  role_arn                = aws_iam_role.rds_proxy.arn
  vpc_subnet_ids          = var.private_subnet_ids
  vpc_security_group_ids  = [aws_security_group.rds_proxy_account_service.id]
  require_tls             = true

  auth {
    # Proxy logs in to db with a username and password stored in Secrets Manager
    auth_scheme = "SECRETS"
    # Clients log in only with an IAM token. Passwords are rejected
    iam_auth    = "REQUIRED"
    # Specifiy which secret holds that username and password
    secret_arn  = aws_db_instance.account_service.master_user_secret[0].secret_arn
  }
}

# Every RDS Proxy gets a target group named `default` automatically.
# Specify the proxy name within that target group
resource "aws_db_proxy_default_target_group" "account_service" {
  db_proxy_name = aws_db_proxy.account_service.name
}

# Register the actual database where the proxy forwards connections to
resource "aws_db_proxy_target" "account_service" {
  db_proxy_name          = aws_db_proxy.account_service.name
  target_group_name      = aws_db_proxy_default_target_group.account_service.name
  db_instance_identifier = aws_db_instance.account_service.identifier
}

# Trust policy for account-services pods to assume
data "aws_iam_policy_document" "pod_identity_assume" {
  statement {
    actions = ["sts:AssumeRole", "sts:TagSession"]
    principals {
      type        = "Service"
      identifiers = ["pods.eks.amazonaws.com"]
    }
  }
}

# IAM role for account-service pods
resource "aws_iam_role" "account_service_pod" {
  name               = "quickbite-account-service-pod-role"
  assume_role_policy = data.aws_iam_policy_document.pod_identity_assume.json
}


# Parses out the proxy's resource ID out of its ARN so that you can specify
# which database the pod's IAM role token is allowed to connect to.
locals {
  rds_proxy_resource_id = element(split(":", aws_db_proxy.account_service.arn), 6)
}

# Permissions that allow pods to connect to db through the proxy
data "aws_iam_policy_document" "rds_connect" {
  statement {
    # 
    actions = ["rds-db:connect"]
    resources = [
      "arn:aws:rds-db:${var.aws_region}:${var.account_id}:dbuser:${local.rds_proxy_resource_id}/${aws_db_instance.account_service.username}"
    ]
  }
}

# Associate the role with the permissions
resource "aws_iam_role_policy" "account_service_rds_connect" {
  name   = "quickbite-account-service-rds-connect"
  role   = aws_iam_role.account_service_pod.id
  policy = data.aws_iam_policy_document.rds_connect.json
}

# Links the account-service ServiceAccount in its namespace to account_service_pod
# ! need to study namespace and service account concepts
resource "aws_eks_pod_identity_association" "account_service" {
  cluster_name    = var.cluster_name
  namespace       = var.pod_namespace
  service_account = var.pod_service_account
  role_arn        = aws_iam_role.account_service_pod.arn
}
